*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual mühitlər və ətraf mühit faylları
.env
.env.*
.venv/
venv/
ENV/
env/

# Müvəqqəti və eksperimental yoxlama skriptləri
scratch/

# Əməliyyat sistemi və redaktor faylları
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
